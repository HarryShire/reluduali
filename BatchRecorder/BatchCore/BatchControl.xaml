<UserControl x:Class="BatchRecorder.BatchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BatchRecorder"
             Foreground="#FFE0E0E0">
  <!-- Layout (2026-10-14): where the takes come from and the CFG sent before each; how they record;
       run; the takes and the log; the tools for when something is stuck, folded away. -->
  <UserControl.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFE0E0E0"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF2A2A2A"/>
      <Setter Property="Foreground" Value="#FFE0E0E0"/>
      <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFE0E0E0"/></Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#FF2A2A2A"/>
      <Setter Property="Foreground" Value="#FFE0E0E0"/>
      <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="12,2,12,6">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="120"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============================================ where the takes come from | the CFG sent before every recording -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="11*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="9*"/>
      </Grid.ColumnDefinitions>
      <local:CardBorder Style="{DynamicResource Card}" Padding="14,10,14,6">
        <StackPanel>
          <TextBlock Text="Takes" FontWeight="SemiBold" FontFamily="{DynamicResource TitleFont}" FontSize="14.5" Margin="0,0,0,8"/>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Take list (CSV)" VerticalAlignment="Center" Opacity="0.75"/>
            <TextBox Grid.Column="1" x:Name="CsvBox"/>
            <Button Grid.Column="2" Content="Load" Margin="8,0,0,0" Click="Load_Click" Style="{DynamicResource PrimaryButton}"
                    ToolTip="Read the take list: one row a take (the CAM QUEUE writes these too)"/>
          </Grid>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Demos folder" VerticalAlignment="Center" Opacity="0.75"/>
            <TextBox Grid.Column="1" x:Name="DemoRootBox"/>
          </Grid>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Output folder" VerticalAlignment="Center" Opacity="0.75"/>
            <TextBox Grid.Column="1" x:Name="OutBox"/>
          </Grid>
        </StackPanel>
      </local:CardBorder>

      <!-- The CFG (Mycelium, 2026-10-01): sent right before every recording, as an editor sends
           their CFG before they hit record. Kept in BatchRecorder.cfg beside the DLL. -->
      <local:CardBorder Grid.Column="2" Style="{DynamicResource Card}" Padding="14,10,14,10">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Send now" Click="CfgSend_Click" Padding="12,3"
                    ToolTip="Send the CFG to the game now, to see what it does."/>
            <TextBlock Text="CFG before every recording" FontWeight="SemiBold" FontFamily="{DynamicResource TitleFont}" FontSize="14.5" VerticalAlignment="Center"
                       ToolTip="Sent right before every recording. One command or 'dvar value' per line; // for comments. Dvars are written straight in, so protected ones take it too."/>
          </DockPanel>
          <TextBox x:Name="CfgBox" Height="100" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                   VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
        </DockPanel>
      </local:CardBorder>
    </Grid>

    <!-- ============================================ how they record -->
    <!-- the Designer puts its POV / CINE global recording above this card (Host), and hides the rows it takes over -->
    <StackPanel x:Name="RecordingSlot" Grid.Row="1">
    <local:CardBorder x:Name="RecordingCard" Style="{DynamicResource Card}" Padding="14,10,14,4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock x:Name="RecordingTitle" Text="Recording" FontWeight="SemiBold" FontFamily="{DynamicResource TitleFont}" FontSize="14.5" Margin="0,0,0,8"/>
        <WrapPanel x:Name="TimingRow" Orientation="Horizontal">
          <TextBlock Text="fps" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,0,6"/>
          <TextBox x:Name="FpsBox" Text="1000" Width="64" Margin="8,0,18,6">
          </TextBox>
          <!-- Buffers around each take (Mycelium, 2026-09-29): seconds before the take list's
               start and after its end, for the edit's handles and a clock that is +-2 s. -->
          <TextBlock Text="before" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,0,6"/>
          <Slider x:Name="BeforeSlider" Minimum="0" Maximum="10" Value="3" TickFrequency="0.5" IsSnapToTickEnabled="True"
                  Width="120" Margin="8,0,4,6" VerticalAlignment="Center"
                  ToolTip="Start recording this many seconds before the take list's start."/>
          <TextBlock Text="{Binding Value, ElementName=BeforeSlider, StringFormat=-{0:0.0} s}" Width="48" VerticalAlignment="Center" Margin="0,0,12,6"/>
          <TextBlock Text="after" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,0,6"/>
          <Slider x:Name="AfterSlider" Minimum="0" Maximum="10" Value="3" TickFrequency="0.5" IsSnapToTickEnabled="True"
                  Width="120" Margin="8,0,4,6" VerticalAlignment="Center"
                  ToolTip="Keep recording this many seconds after the take list's end."/>
          <TextBlock Text="{Binding Value, ElementName=AfterSlider, StringFormat=+{0:0.0} s}" Width="48" VerticalAlignment="Center" Margin="0,0,16,6"/>
          <CheckBox x:Name="NoHudBox" Content="No HUD (hides the feed)" Margin="0,0,14,6" VerticalAlignment="Center"
                    ToolTip="Sends cg_draw2d 0: no kill feed, no +100. For cinematics. Off: the CODCAST panel's own settings decide."/>
        </WrapPanel>
        <WrapPanel x:Name="PassesRow" Orientation="Horizontal">
          <TextBlock Text="Passes" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,10,6"/>
          <CheckBox x:Name="DepthBox" Content="Depth" IsChecked="False" Margin="0,0,4,6" VerticalAlignment="Center">
          </CheckBox>
          <TextBox x:Name="DepthDistBox" Text="2000" Width="54" Margin="0,0,4,6" VerticalAlignment="Center">
          </TextBox>
          <TextBlock Text="units" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,12,6"/>
          <CheckBox x:Name="NoPlayersBox" Content="No players" IsChecked="False" Margin="0,0,12,6" VerticalAlignment="Center"
                    ToolTip="Reluduali recorder: the take again with the players gone, their guns and gear with them ('&lt;take&gt; - world')."/>
          <CheckBox x:Name="PlayersOnlyBox" Content="Players only" IsChecked="False" Margin="0,0,12,6" VerticalAlignment="Center"
                    ToolTip="Reluduali recorder: the take again with only the players, their guns and the view hands, on black ('&lt;take&gt; - players'); with Depth ticked, its depth is the players' matte."/>
          <CheckBox x:Name="PlateBox" Content="Clean plate" IsChecked="False" Margin="0,0,12,6" VerticalAlignment="Center"
                    ToolTip="Reluduali recorder: a second video beside each take, '&lt;take&gt; - plate', the scene before bloom, the colour grade and the HUD (the gun stays). Same codec as the take."/>
        </WrapPanel>
        <WrapPanel x:Name="OutputRow" Orientation="Horizontal">
          <!-- 2026-10-18 (Mycelium: "There's no point in clicking video no pngs because clicking on the codec already implies
               that ... they could select pngs from this drop-down"): no Video box; a PNG sequence is one of the choices. -->
          <TextBlock Text="codec" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,8,6"/>
          <ComboBox x:Name="CodecBox" Width="230" Margin="0,0,14,6" VerticalAlignment="Center" SelectedIndex="0"
                    ToolTip="What each take is written as: a video in one of these codecs, or a PNG per frame in a folder named after the take.">
            <!-- Measured 2026-09-29 on 537 real frames at 3050x1668 (0126): DNxHR HQ 55 fps and
                 2.15 MB/frame; ProRes HQ 20 fps (slower than capture); CineForm refuses 3050
                 wide; the MF encoders exist on the host GPU but not in the sandbox. -->
            <!-- 0133: all-intra H.264 CRF 12 is 0.39 MB/frame at 44.7 dB PSNR (DNxHR HQ: 2.15 MB, 47.8 dB),
                 the fastest encoder measured, and every frame a keyframe for time remapping. -->
            <ComboBoxItem Content="H.264 all-intra CRF 12 (.mp4)" Tag="mp4|-c:v libx264 -preset veryfast -crf 12 -g 1 -pix_fmt yuv420p -movflags +faststart"/>
            <ComboBoxItem Content="DNxHR HQ (.mov)" Tag="mov|-c:v dnxhd -profile:v dnxhr_hq -pix_fmt yuv422p"/>
            <ComboBoxItem Content="ProRes 422 HQ (.mov)" Tag="mov|-c:v prores_ks -profile:v 3 -pix_fmt yuv422p10le -vendor apl0"/>
            <ComboBoxItem Content="ProRes 4444 (.mov)" Tag="mov|-c:v prores_ks -profile:v 4 -pix_fmt yuv444p10le -vendor apl0"/>
            <ComboBoxItem Content="Ut Video RGB lossless (.avi)" Tag="avi|-c:v utvideo -pix_fmt gbrp -pred median"/>
            <ComboBoxItem Content="HEVC on the GPU (.mp4)" Tag="mp4|-c:v hevc_mf -rate_control quality -quality 95 -hw_encoding 1 -pix_fmt nv12"/>
            <ComboBoxItem Content="PNG sequence (no video)" Tag="png|-c:v png -pix_fmt rgb24 -start_number 0"/>
          </ComboBox>
          <TextBlock Text="ffmpeg" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,0,6"/>
          <TextBox x:Name="FfmpegBox" Width="280" Margin="8,0,0,6" VerticalAlignment="Center"
                   ToolTip="Full path to ffmpeg.exe"/>
        </WrapPanel>
      </StackPanel>
    </local:CardBorder>
    </StackPanel>

    <!-- ============================================ run: the switches, then the buttons; the clock's zero beside them -->
    <StackPanel x:Name="RunSlot" Grid.Row="2">
    <local:CardBorder x:Name="RunCard" Style="{DynamicResource Card}" Padding="14,10,14,4" Margin="0,0,0,10">
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="AllButton" Content="Run all" Padding="18,5" Margin="0,0,8,6" Click="RunAll_Click" Style="{DynamicResource PrimaryButton}"
                ToolTip="Record every take in the list, one after the other"/>
        <Button x:Name="OneButton" Content="Run selected take" Padding="12,4" Margin="0,0,8,6" Click="RunOne_Click"/>
        <Button x:Name="StopButton" Content="Stop" Padding="14,4" Margin="0,0,20,6" IsEnabled="False" Click="Stop_Click" Style="{DynamicResource DangerButton}"/>
        <CheckBox x:Name="DryRunBox" Content="Dry run (no recording)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,6"/>
        <CheckBox x:Name="LoadEachBox" Content="Load each demo" VerticalAlignment="Center" Margin="0,0,14,6" ToolTip="Off: use the demo already on the theater screen."/>
        <CheckBox x:Name="CodcastBox" Content="Require CODCAST" IsChecked="True" VerticalAlignment="Center" Margin="0,0,24,6"
                  ToolTip="Refuse to record unless the replay is in FILM CODCAST mode. Read from the game, not assumed."/>
        <TextBlock Text="clock reads" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,0,6"/>
        <TextBox x:Name="HudBox" Width="64" Margin="8,0,6,6" ToolTip="What the paused theater clock shows right now, e.g. 1:54"/>
        <Button Content="Set zero" Padding="10,3" Margin="0,0,6,6" Click="SetZero_Click"/>
        <TextBlock x:Name="ZeroText" Text="zero: measure" VerticalAlignment="Center" Margin="0,0,10,6" Opacity="0.8"/>
        <Button Content="Calibrate" Padding="10,3" Margin="0,0,0,6" Click="Calibrate_Click"/>
      </WrapPanel>
    </local:CardBorder>
    </StackPanel>

    <!-- ============================================ the takes and the log -->
    <Grid x:Name="TakesArea" Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TakesColumn" Width="320"/><ColumnDefinition x:Name="LogColumn" Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="TakesSlot"><ListBox x:Name="TakesBox"/></Border>
      <TextBox Grid.Column="1" x:Name="LogBox" Margin="10,0,0,0" IsReadOnly="True" VerticalContentAlignment="Top"
               AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"/>
    </Grid>

    <!-- ============================================ the three unknowns, each on its own button so a failure has one cause -->
    <Expander Grid.Row="4" Header="Tools for when something is stuck" Margin="0,10,0,0">
      <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="Read state" Padding="10,3" Margin="0,0,6,6" Click="State_Click"/>
        <TextBlock Text="command" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,0,6"/>
        <TextBox x:Name="SendBox" Width="210" Margin="6,0,6,6" ToolTip="Sent to the game exactly as typed."/>
        <Button Content="Send" Padding="10,3" Margin="0,0,6,6" Click="Send_Click"/>
        <Button x:Name="EnterButton" Content="Press ENTER" Padding="10,3" Margin="0,0,18,6" Click="Enter_Click">
        </Button>
        <Button Content="Roster" Padding="10,3" Margin="0,0,6,6" Click="Roster_Click"
                ToolTip="Reads the spectate roster out of the game, in selectedPlayerIndex order."/>
        <TextBox x:Name="PovBox" Width="140" Margin="0,0,6,6" ToolTip="A gamertag, as it appears in the take list."/>
        <Button Content="Go to POV" Padding="10,3" Margin="0,0,18,6" Click="Pov_Click"/>
        <Button Content="Set CODCAST" Padding="10,3" Margin="0,0,6,6" Click="Codcast_Click" Tag="on"
                ToolTip="The film in FILM CODCAST mode (bit 2 of the demo-mode byte). Redacted only."/>
        <Button Content="Set regular theater" Padding="10,3" Margin="0,0,0,6" Click="Codcast_Click" Tag="off"
                ToolTip="The film in the regular theater: FREE CAMERA, Edit Camera and the dolly. Redacted only."/>
      </WrapPanel>
    </Expander>

    <TextBlock Grid.Row="5" x:Name="StatusText" Text="Idle." Margin="2,8,0,0" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
