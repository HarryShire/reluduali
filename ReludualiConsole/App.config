<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- "I dont see why UI's should ever crash, they're just UIs." An exception on a
         worker thread is logged (App.xaml.cs) instead of ending the console. -->
    <legacyUnhandledExceptionPolicy enabled="1" />
  </runtime>
</configuration>
